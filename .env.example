# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Neon Postgres connection string. `vercel env pull` writes it to .env.local.
# All tables are created on startup (or run `bun run migrate`).
DATABASE_URL=

# OpenRouter key for the vision model that reads photos (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Optional: any OpenRouter vision model with structured outputs (default google/gemini-3.8-flash).
# VISION_MODEL=

# Small LLM for understanding free-form texts (any OpenAI-compatible API).
# Defaults to local Ollama: `ollama pull qwen2.5:7b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# Wardrobe page. Defaults to this machine's LAN address on port 3000.
# PORT=3000
# PUBLIC_URL=https://your-tunnel.example.com

# The number people text to start the bot (shown as a QR code on the landing page).
# BOT_NUMBER=+16282679185
